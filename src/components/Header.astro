---
const currentPath = Astro.url.pathname;

const navItems = [
  { href: '/', label: 'Home' },
  { href: '/collection', label: 'Collection' },
];
---

<header class="site-header">
  <nav class="nav">
    {navItems.map((item) => {
      const active = item.href === '/'
        ? currentPath === '/'
        : currentPath.startsWith(item.href);
      return (
        <a href={item.href} class={active ? 'nav-link active' : 'nav-link'}>
          {item.label}
        </a>
      );
    })}
  </nav>

  <a href="/" class="logo">Rayla Seraphine</a>

  <div class="nav-spacer"></div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 100;
    background: var(--bg-header);
    padding: 16px 32px;
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 16px;
  }

  .nav {
    display: flex;
    gap: 24px;
  }

  .nav-link {
    font-size: 14px;
    color: var(--text);
    opacity: 0.7;
    transition: opacity 0.15s ease;
  }

  .nav-link:hover {
    opacity: 1;
  }

  .nav-link.active {
    font-weight: 700;
    opacity: 1;
  }

  .logo {
    font-size: 16px;
    font-weight: 700;
    text-align: center;
  }
</style>